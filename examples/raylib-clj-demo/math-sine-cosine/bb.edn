;; Run this demo from here with `bb run`. From the repo root it's `bb math-sine-cosine`.
;; GUI apps need `clojure`, not `clj` (rlwrap breaks them).
{:tasks
 {run {:doc "\u25b6 Unit circle with sine, cosine, tangent and related angles drawn live"
       :override-builtin true
       :task (let [{:keys [exit]} (shell {:continue true} "clojure" "-M:run")]
               (when-not (zero? exit) (System/exit exit)))}}}
