# Clojure CLI classpath cache and build output
.cpcache/
target/
.nrepl-port

# clj-kondo's analysis cache (the config and the coffi/defcfn hook next to it
# are tracked) and the configs clojure-lsp auto-imports
.clj-kondo/.cache/
.clj-kondo/imports/
.lsp/.cache/
.lsp/sqlite.db

# storage-values writes this at runtime, in its own directory
storage.data

# docs-engine build output and a local engine checkout
_site/
.docs-engine/

# screen-grab teardown markers (out-dir scratch; recover-pending! executes these)
docs/demos/.screen-grab-pending.edn*

.remember/
.DS_Store
