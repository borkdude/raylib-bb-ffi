;; Run this demo from here with `bb run`. From the repo root it's `bb tiled-drawing`.
;; GUI apps need `clojure`, not `clj` (rlwrap breaks them).
{:tasks
 {run {:doc "\u25b6 Tile a texture patch with selectable pattern, tint, scale and rotation"
       :override-builtin true
       :task (let [{:keys [exit]} (shell {:continue true} "clojure" "-M:run")]
               (when-not (zero? exit) (System/exit exit)))}}}
