;; Run this demo from here with `bb run`. From the repo root it's `bb heightmap-rendering`.
;; GUI apps need `clojure`, not `clj` (rlwrap breaks them).
{:tasks
 {run {:doc "\u25b6 Terrain mesh generated from a greyscale PNG, brightness as elevation"
       :override-builtin true
       :task (let [{:keys [exit]} (shell {:continue true} "clojure" "-M:run")]
               (when-not (zero? exit) (System/exit exit)))}}}
