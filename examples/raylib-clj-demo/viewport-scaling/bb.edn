;; Run this demo from here with `bb run`. From the repo root it's `bb viewport-scaling`.
;; GUI apps need `clojure`, not `clj` (rlwrap breaks them).
{:tasks
 {run {:doc "\u25b6 Six ways to fit a fixed-resolution game onto a resizable window"
       :override-builtin true
       :task (let [{:keys [exit]} (shell {:continue true} "clojure" "-M:run")]
               (when-not (zero? exit) (System/exit exit)))}}}
