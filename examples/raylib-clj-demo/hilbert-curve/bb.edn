;; Run this demo from here with `bb run`. From the repo root it's `bb hilbert-curve`.
;; GUI apps need `clojure`, not `clj` (rlwrap breaks them).
{:tasks
 {run {:doc "\u25b6 Space-filling curve drawn stroke by stroke with hue along its length"
       :override-builtin true
       :task (let [{:keys [exit]} (shell {:continue true} "clojure" "-M:run")]
               (when-not (zero? exit) (System/exit exit)))}}}
