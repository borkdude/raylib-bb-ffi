;; Run this demo from here with `bb run`. From the repo root it's `bb keyboard-testbed`.
;; GUI apps need `clojure`, not `clj` (rlwrap breaks them).
{:tasks
 {run {:doc "\u25b6 On-screen ENG-US keyboard showing what raylib reports per key"
       :override-builtin true
       :task (let [{:keys [exit]} (shell {:continue true} "clojure" "-M:run")]
               (when-not (zero? exit) (System/exit exit)))}}}
