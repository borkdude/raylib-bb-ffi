;; Task runner for raylib-clj-demo: 113 raylib examples in Clojure, one sub-project each.
;;
;; Run these from the repo root with `bb <task>`.
;;
;;   bb info               grouped cheat-sheet, every demo included
;;   bb <demo>             run one demo, e.g. bb asteroids
;;   bb run <demo>         the same, by argument
;;   bb list               flat list of demos with descriptions
;;   bb run-all [secs]     every demo for N seconds each (default 4), unattended
;;   bb check              compile every scene, no window
;;   bb lint               clj-kondo over every demo; errors fail, warnings are reported
;;   bb lint:strict        bb lint, but warnings fail too
;;   bb doctor             java 22+, clojure, the raylib-clj dependency, libraylib
;;   bb gen [--check]      rebuild deps.edn, check.clj, these tasks and the gallery
;;   bb record [opts]      record demo GIFs with screen-grab (maintainer-only), then sync
;;   bb sync-recordings    copy docs/demos/ recordings into each demo's own docs/demos/
;;
;; Every demo runs from its own directory (`clojure -M:run`), because the ones
;; with assets load them from ./resources by relative path. The demo list is
;; demos.edn, edited by hand, and the per-demo tasks at the bottom are written
;; from it by `bb gen`.
;;
;; GUI apps need `clojure`, not `clj`: rlwrap breaks them.
;;
;; NOTE: task bodies are EDN-parsed. No #"regex", no @deref, no #(...).
{:min-bb-version "1.3.0"
 :paths ["scripts"]
 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.edn :as edn]
             [clojure.string :as str])

  :init
  (do
    ;; [{:name :category :title :desc :controls :ported} ...], edited by hand.
    (def demos (if (fs/exists? "demos.edn") (edn/read-string (slurp "demos.edn")) []))

    (defn find-demo [s]
      (first (filter (fn [d] (= s (:name d))) demos)))

    (defn demo! [name]
      (or (find-demo name)
          (do (binding [*out* *err*]
                (println (str "No demo named " name ". `bb list` shows them all.")))
              (System/exit 1))))

    (defn run-demo
      "Run one demo from its own directory, where its resources/ resolve."
      [name]
      (let [d (demo! name)]
        (shell {:continue true :dir (:name d)} "clojure" "-M:run")))

    (defn exit-with [{:keys [exit]}]
      (when-not (zero? exit) (System/exit exit)))

    ;; Every source root clj-kondo should see: the check namespace and each demo.
    (defn lint-dirs []
      (concat ["src"] (map (fn [d] (str (:name d) "/src")) demos)))

    (defn kondo! []
      (when-not (fs/which "clj-kondo")
        (binding [*out* *err*]
          (println "bb lint needs clj-kondo on PATH: https://github.com/clj-kondo/clj-kondo/blob/master/doc/install.md"))
        (System/exit 1))
      (apply shell {:continue true} "clj-kondo" "--lint" (lint-dirs))))

  info
  {:doc "Grouped cheat-sheet, every demo included (start here)"
   :task
   (let [esc (str (char 27) "[")
         col (fn [c s] (str esc c "m" s esc "0m"))
         hdr (fn [s] (println (str "\n" (col "35" (str "── " s " ──")))))
         row (fn [t d] (println (str "  " (col "36" (format "%-32s" (str "bb " t))) d)))]
     (println (col "1;35" "\nraylib-clj-demo: 113 raylib examples in Clojure, one sub-project each"))
     (hdr "Run")
     (row "<demo>" "run one demo, e.g. asteroids")
     (row "run <demo>" "the same, by argument")
     (row "list" "flat list of demos with descriptions")
     (row "run-all [secs]" "every demo for N seconds each (default 4), unattended")
     (hdr "Verify")
     (row "doctor" "java 22+, clojure, the raylib-clj dependency, libraylib")
     (row "check" "compile every scene, no window")
     (row "lint" "clj-kondo over every demo; errors fail (lint:strict: warnings too)")
     (hdr "Maintenance")
     (row "gen [--check]" "rebuild deps.edn, check.clj, demo tasks and gallery from demos.edn")
     (row "record [--only a,b] [--force]" "record demo GIFs with screen-grab (maintainer-only)")
     (row "sync-recordings [--check]" "copy docs/demos/ recordings into each demo's docs/demos/")
     (doseq [[category ds] (sort-by key (group-by :category demos))]
       (hdr (str category " (" (count ds) ")"))
       (doseq [d ds] (row (:name d) (or (:desc d) ""))))
     (println (str "\n" (col "2" "first run: bb doctor, then bb asteroids"))))}

  list
  {:doc "Flat list of demos with descriptions"
   :task (let [w (apply max (map (fn [d] (count (:name d))) demos))]
           (doseq [d demos]
             (println (format (str "%-" w "s  %-9s  %s") (:name d) (:category d) (or (:desc d) "")))))}

  run
  {:doc "Run one demo by name: run <demo>"
   :override-builtin true
   :task (if-let [name (first *command-line-args*)]
           (exit-with (run-demo name))
           (do (println "usage: bb run <demo>   (bb list shows them)")
               (System/exit 1)))}

  run-all
  {:doc "Every demo for N seconds each (default 4), unattended; exits 1 if any fail"
   ;; The examples have no auto-quit, so this stops each one itself. Its clock
   ;; starts when raylib logs "DISPLAY: Device initialized", so JVM start-up
   ;; costs nothing extra. A demo still running at the end passed. One that
   ;; exits non-zero, or never opens its window within 60s, failed.
   :task (let [secs (Long/parseLong (or (first *command-line-args*) "4"))
               run-one (fn [n]
                         (let [proc (p/process {:dir n :err :out} "clojure" "-M:run")
                               rdr (java.io.BufferedReader. (java.io.InputStreamReader. (:out proc)))
                               ready (promise)
                               ;; Keeps draining stdout after the window is up, so
                               ;; a full pipe never blocks the demo.
                               _ (future
                                   (try (loop []
                                          (when-let [l (.readLine rdr)]
                                            (when (str/includes? l "DISPLAY: Device initialized")
                                              (deliver ready true))
                                            (recur)))
                                        (catch Exception _ nil))
                                   (deliver ready false))
                               up (deref ready 60000 false)]
                           (if up
                             (do (Thread/sleep (* 1000 secs))
                                 (if (p/alive? proc)
                                   (do (p/destroy-tree proc) 0)
                                   (:exit (deref proc))))
                             (do (p/destroy-tree proc)
                                 (let [e (:exit (deref proc 5000 nil))]
                                   (if (and e (not (zero? e))) e 99))))))
               failed (vec (for [d demos
                                 :let [_ (println (str "▶ " (:name d)))
                                       exit (run-one (:name d))]
                                 :when (not (zero? exit))]
                             (str (:name d) " (exit " exit ")")))]
           (println (str "\n" (- (count demos) (count failed)) "/" (count demos) " demos ran without failing"))
           (when (seq failed)
             (println (str "failed: " (str/join ", " failed)))
             (System/exit 1)))}

  check
  {:doc "Compile every scene, no window"
   :task (exit-with (shell {:continue true} "clojure" "-M:check"))}

  lint
  {:doc "clj-kondo over every demo: warnings are reported, errors fail"
   ;; Same gate raylib-clj uses. clj-kondo exits 2 for warnings and 3 for
   ;; errors. The 68 warnings in the demos (mostly unused bindings) came over
   ;; with the code from raylib-clj, where they were reported the same way.
   :task (let [{:keys [exit]} (kondo!)]
           (cond (zero? exit) (println "OK clj-kondo: no errors or warnings")
                 (= 2 exit) (println "clj-kondo: warnings above, not failing; the gate is errors")
                 :else (System/exit exit)))}

  lint:strict
  {:doc "bb lint, but exit non-zero on any warning or error"
   :task (exit-with (kondo!))}

  doctor
  {:doc "Check java 22+, clojure, the raylib-clj dependency and libraylib"
   :task (let [java-major (try (let [v (:err (shell {:err :string :continue true} "java" "-version"))
                                     m (re-find (re-pattern "version \"(\\d+)") (or v ""))]
                                 (some-> m second Long/parseLong))
                               (catch Exception _ nil))
               lib-paths ["/opt/homebrew/lib/libraylib.6.0.0.dylib" "/usr/local/lib/libraylib.6.0.0.dylib"
                          "/usr/lib/libraylib.so" "/usr/local/lib/libraylib.so"
                          "/usr/lib/x86_64-linux-gnu/libraylib.so"]
               checks [["java 22+ (coffi needs the final FFM API)" (and java-major (>= java-major 22))
                        "install a JDK 22 or newer"]
                       ["clojure on PATH" (fs/which "clojure") "install the Clojure CLI: https://clojure.org/guides/install_clojure"]
                       ;; Resolving the classpath fetches the pinned raylib-clj the
                       ;; first time, so this also proves the network can reach it.
                       ["raylib-clj (the bindings, pinned in common/deps.edn)"
                        (and (fs/which "clojure")
                             (str/includes? (:out (shell {:out :string :err :string :continue true} "clojure" "-Spath"))
                                            "raylib-clj"))
                        "check network access to github.com, then common/deps.edn's :git/sha"]
                       ["libraylib 6.0" (some fs/exists? lib-paths)
                        "brew install raylib, or your distro's raylib package (6.0+)"]
                       ["demos.edn" (fs/exists? "demos.edn") "restore it from git"]]]
           (doseq [[what ok fix] checks]
             (println (str (if ok "  ok    " "  MISSING ") what (when-not ok (str "  -> " fix)))))
           (when-not (every? second checks) (System/exit 1)))}

  demos:examples
  {:doc "Print every demo as EDN for screen-grab's :examples-cmd"
   ;; screen-grab's working directory is per manifest, not per item, so each
   ;; item cds into its demo. exec keeps the window in the process it spawned.
   :task (prn (vec (for [d demos
                         :let [n (:name d)]]
                     {:id n
                      :group (:category d)
                      :desc (:desc d)
                      :src (str n "/src/net/b12n/raylib_clj/scenes/" (str/replace n "-" "_") ".clj")
                      :run (str "sh -c 'cd " n " && exec clojure -M:run'")})))}

  record
  {:doc "Record demo GIFs into docs/demos/ (screen-grab), then sync each demo's copy and the gallery"
   :task (if-not (fs/which "screen-grab")
           (binding [*out* *err*]
             (println "bb record needs the `screen-grab` capture CLI on your PATH.")
             (println "That tool is internal and not publicly released yet, so this task is")
             (println "maintainer-only. Every recording is committed, so you never need it to")
             (println "view the demos.")
             (System/exit 1))
           (let [{:keys [exit]} (apply shell {:continue true}
                                       "screen-grab" "record"
                                       "--manifest" "scripts/demo_manifest.edn"
                                       *command-line-args*)]
             ;; Sync even after a partial failure: the items that did record
             ;; should reach their demo's folder and the gallery.
             (when-not (some #{"--dry-run" "--list"} *command-line-args*)
               (shell "bb" "sync-recordings")
               (shell "bb" "gen"))
             (when-not (zero? exit) (System/exit exit))))}

  sync-recordings
  {:doc "Copy docs/demos/ recordings into each demo's own docs/demos/: sync-recordings [--check]"
   :requires ([sync-recordings])
   :task (apply sync-recordings/-main *command-line-args*)}

  gen
  {:doc "Rebuild deps.edn, check.clj, demo tasks and gallery from demos.edn: gen [--check]"
   :requires ([gen])
   :task (apply gen/-main *command-line-args*)}

